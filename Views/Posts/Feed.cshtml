@model List<PoliNewsWeb.Models.Post>

@{
    ViewData["Title"] = "Vídeos";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>Poli News - Vídeos</title>
    <link rel="stylesheet" href="~/css/feed.css" />
</head>
<body class="fundo-feed">

    <a href="/Canais" class="botao-voltar-feed">← Voltar</a>

    @if (Context.Session.GetString("TipoUsuario") == "admin")
    {
        <a href="/Posts/CriarVideo" class="botao-novo-video">+ Novo Vídeo</a>
    }

    <div class="feed-video">
        @if (Model.Count == 0)
        {
            <div class="feed-item">
                <p class="feed-vazio">Nenhum vídeo publicado ainda.</p>
            </div>
        }
        else
        {
            @foreach (var post in Model)
            {
                string? idVideo = post.VideoUrl?.Split('/').Last();
                int qtdComentarios = post.Comentarios?.Count ?? 0;

                <div class="feed-item">
                    <iframe
                        src="https://www.youtube.com/embed/@idVideo?rel=0&modestbranding=1&controls=0&playsinline=1"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen>
                    </iframe>

                    <div class="feed-overlay-lateral">
                        <a href="/Canais/Perfil/@post.CanalId" class="feed-avatar-wrapper">
                            <img src="@post.Canal.Foto" class="feed-avatar-lateral" alt="@post.Canal.Nome" />
                        </a>

                        <button type="button" class="feed-botao-icone" onclick="curtir(@post.Id)">
                            <svg class="feed-emoji" id="coracao-@post.Id" viewBox="0 0 24 24" fill="white">
                                <path d="M12 21s-6.7-4.35-9.33-8.28C.87 9.92 1.62 6.5 4.34 5.02 6.4 3.9 8.9 4.5 10.2 6.3L12 8.6l1.8-2.3c1.3-1.8 3.8-2.4 5.86-1.28 2.72 1.48 3.47 4.9 1.67 7.7C18.7 16.65 12 21 12 21z"/>
                            </svg>
                            <span class="feed-contador" id="contador-curtida-@post.Id">@post.Curtidas</span>
                        </button>

                        <div class="feed-botao-icone" onclick="abrirComentarios(@post.Id)">
                            <svg class="feed-emoji" viewBox="0 0 24 24">
                                <path fill="white" d="M4 4h16a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H9l-5 4v-4H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/>
                                <circle cx="8" cy="9.5" r="1.3" fill="#16171a"/>
                                <circle cx="12" cy="9.5" r="1.3" fill="#16171a"/>
                                <circle cx="16" cy="9.5" r="1.3" fill="#16171a"/>
                            </svg>
                            <span class="feed-contador" id="contador-comentario-@post.Id">@qtdComentarios</span>
                        </div>

                        <div class="feed-botao-icone" onclick="compartilhar('@post.Id')">
                            <svg class="feed-emoji" viewBox="0 0 24 24" fill="white">
                                <path d="M4 11h13.17l-5.58-5.59L13 4l8 8-8 8-1.41-1.41L17.17 13H4z"/>
                            </svg>
                            <span class="feed-contador">Share</span>
                        </div>

                        <img src="@post.Canal.Foto" class="feed-disco-musical" alt="som" />
                    </div>

                    <div class="feed-info">
                        <a href="/Canais/Perfil/@post.CanalId" class="feed-canal-link">
                            <span class="feed-canal">@("@"+post.Canal.Nome)</span>
                        </a>
                        <div class="feed-texto-wrapper">
                            <p class="feed-texto feed-texto-fechado" id="texto-@post.Id">
                                @post.Titulo — @post.Texto
                            </p>
                        </div>
                        <span class="feed-toggle" onclick="toggleTexto(@post.Id, this)">ver mais</span>
                    </div>
                </div>
            }
        }
    </div>

    <!-- ===== Gaveta de comentários (fica escondida até clicar no 💬) ===== -->
    <div class="comentarios-overlay" id="comentarios-overlay" onclick="fecharComentarios()"></div>
    <div class="comentarios-drawer" id="comentarios-drawer">
        <div class="comentarios-header">
            <span>Comentários</span>
            <button class="comentarios-fechar" onclick="fecharComentarios()">✕</button>
        </div>
        <div class="comentarios-lista" id="lista-comentarios">
            <!-- carregado via JavaScript -->
        </div>
        <form class="comentarios-form" onsubmit="enviarComentario(event)">
            <input type="text" id="input-comentario" placeholder="Adicione um comentário..." maxlength="300" autocomplete="off" />
            <button type="submit">Enviar</button>
        </form>
    </div>

    <script>
        function toggleTexto(id, el) {
            var texto = document.getElementById('texto-' + id);
            texto.classList.toggle('feed-texto-fechado');
            el.textContent = texto.classList.contains('feed-texto-fechado') ? 'ver mais' : 'ver menos';
        }

        function compartilhar(id) {
            const url = window.location.origin + '/Posts/Ver/' + id;
            navigator.clipboard.writeText(url);
            alert('Link copiado!');
        }

        function curtir(postId) {
            fetch('/Posts/Curtir/' + postId, { method: 'POST' })
                .then(() => {
                    const contador = document.getElementById('contador-curtida-' + postId);
                    if (contador) {
                        contador.textContent = parseInt(contador.textContent) + 1;
                    }
                    const coracao = document.getElementById('coracao-' + postId);
                    if (coracao) {
                        coracao.classList.add('curtido');
                    }
                });
        }

        // ===== Comentários =====
        let postoAtualComentario = null;

        function abrirComentarios(postId) {
            postoAtualComentario = postId;
            document.getElementById('comentarios-overlay').classList.add('aberto');
            document.getElementById('comentarios-drawer').classList.add('aberto');
            carregarComentarios(postId);
        }

        function fecharComentarios() {
            document.getElementById('comentarios-overlay').classList.remove('aberto');
            document.getElementById('comentarios-drawer').classList.remove('aberto');
        }

        function carregarComentarios(postId) {
            fetch('/Posts/ListarComentarios?postId=' + postId)
                .then(r => r.text())
                .then(html => {
                    document.getElementById('lista-comentarios').innerHTML = html;
                });
        }

        function excluirComentario(comentarioId) {
            if (!confirm('Excluir este comentário?')) return;
            fetch('/Posts/ExcluirComentario/' + comentarioId, { method: 'POST' })
                .then(r => r.text())
                .then(html => {
                    document.getElementById('lista-comentarios').innerHTML = html;
                    const contador = document.getElementById('contador-comentario-' + postoAtualComentario);
                    if (contador) {
                        contador.textContent = Math.max(0, parseInt(contador.textContent) - 1);
                    }
                });
        }

        function enviarComentario(event) {
            event.preventDefault();
            const input = document.getElementById('input-comentario');
            const texto = input.value.trim();
            if (!texto || postoAtualComentario === null) return;

            const dados = new URLSearchParams();
            dados.append('postId', postoAtualComentario);
            dados.append('texto', texto);

            fetch('/Posts/Comentar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: dados
            }).then(() => {
                input.value = '';
                carregarComentarios(postoAtualComentario);

                const contador = document.getElementById('contador-comentario-' + postoAtualComentario);
                if (contador) {
                    contador.textContent = parseInt(contador.textContent) + 1;
                }
            });
        }
    </script>

</body>
</html>