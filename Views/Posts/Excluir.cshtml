@model PoliNewsWeb.Models.Post

@{
    ViewData["Title"] = "Excluir Post";
}

<h1>Excluir Post</h1>
<h3>Tem certeza que deseja excluir este post?</h3>

<div class="cartao-excluir">
    <h4>@Model.Titulo</h4>
    <p>@Model.Texto</p>
    <img src="@Model.Foto" alt="@Model.Titulo" width="200" />
</div>

<form asp-action="Excluir">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="botao-confirmar-exclusao">Confirmar exclusão</button>
</form>